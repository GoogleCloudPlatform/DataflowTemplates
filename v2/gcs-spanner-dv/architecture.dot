digraph Architecture {
    rankdir=LR;
    compound=true;
    node [shape=box, style=rounded, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=11];

    GCS [label="Google Cloud Storage\n(Avro Data)", shape=cylinder];
    Spanner [label="Cloud Spanner\n(Destination DB)", shape=cylinder];

    subgraph cluster_Config {
        label = "Configuration & Mapping";
        style = dashed;
        fontname = "Helvetica";
        TableConfig [label="TableConfiguration\n(--tables / --tableConfigurationFilePath)"];
        SchemaMapper [label="SchemaMapperProviderFn\n(Session / Overrides)"];
        CustomTransform [label="CustomTransformation\n(Optional JAR)"];
    }

    subgraph cluster_InfoSchema {
        label = "SpannerInformationSchemaProcessorTransform";
        fontname = "Helvetica";
        ProcessInfoSchema [label="ProcessInformationSchemaFn\n(Fetch Spanner DDL)"];
    }

    subgraph cluster_SourceReader {
        label = "SourceReaderTransform";
        fontname = "Helvetica";
        AvroRead [label="AvroIO.readAllGenericRecords"];
        SourceHash [label="SourceHashFn\n(ComparisonRecordMapper +\nUnifiedHasherVisitor)"];
        AvroRead -> SourceHash;
    }

    subgraph cluster_SpannerReader {
        label = "SpannerReaderTransform";
        fontname = "Helvetica";
        CreateReadOps [label="CreateSpannerReadOpsFn"];
        BatchSpannerRead [label="SpannerIO.readAll\n(BatchSpannerRead, 15s staleness)"];
        SpannerHash [label="SpannerHashFn\n(ComparisonRecordMapper +\nUnifiedHasherVisitor)"];
        CreateReadOps -> BatchSpannerRead -> SpannerHash;
    }

    subgraph cluster_MatchRecords {
        label = "MatchRecordsTransform";
        fontname = "Helvetica";
        CoGroup [label="CoGroupByKey\n(Key: Murmur3_128 Hash)"];
        Funnel [label="FunnelComparedRecordsFn\n(MATCHED_TAG /\nMISSING_IN_SPANNER_TAG /\nMISSING_IN_SOURCE_TAG)"];
        CoGroup -> Funnel;
    }

    subgraph cluster_ReportResults {
        label = "ReportResultsTransform";
        fontname = "Helvetica";
        FormatMismatches [label="transformMismatchedRecords\n(MISSING_IN_DESTINATION /\nMISSING_IN_SOURCE)"];
        ComputeStats [label="ComputeTableStatsFn"];
        CombineSummary [label="ValidationSummaryCombineFn"];
        ComputeStats -> CombineSummary;
    }

    subgraph cluster_BigQuery {
        label = "BigQuery (Validation Results)";
        fontname = "Helvetica";
        BQMismatches [label="MismatchedRecords\n(FILE_LOADS)", shape=cylinder];
        BQTableStats [label="TableValidationStats\n(FILE_LOADS)", shape=cylinder];
        BQSummary [label="ValidationSummary\n(STREAMING_INSERTS)", shape=cylinder];
    }

    Spanner -> ProcessInfoSchema;
    ProcessInfoSchema -> SourceHash [label="PCollectionView<Ddl>", style=dashed];
    ProcessInfoSchema -> CreateReadOps [label="PCollectionView<Ddl>", style=dashed];
    ProcessInfoSchema -> SpannerHash [label="PCollectionView<Ddl>", style=dashed];

    TableConfig -> AvroRead [style=dotted];
    TableConfig -> CreateReadOps [style=dotted];
    SchemaMapper -> AvroRead [style=dotted];
    SchemaMapper -> SourceHash [style=dotted];
    SchemaMapper -> CreateReadOps [style=dotted];
    SchemaMapper -> SpannerHash [style=dotted];
    CustomTransform -> SourceHash [style=dotted];

    GCS -> AvroRead;
    SourceHash -> CoGroup [label="Source ComparisonRecords\n(SOURCE_TAG)"];

    Spanner -> BatchSpannerRead;
    SpannerHash -> CoGroup [label="Spanner ComparisonRecords\n(SPANNER_TAG)"];

    Funnel -> FormatMismatches [label="Mismatched tags"];
    Funnel -> ComputeStats [label="All tags"];

    FormatMismatches -> BQMismatches;
    ComputeStats -> BQTableStats;
    CombineSummary -> BQSummary;
}
