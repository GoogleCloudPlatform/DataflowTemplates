            "default": null
          },
          {
            "name": "timestamp_ltz_col",
            "type": [ "null", { "type": "long", "logicalType": "timestamp-micros" } ],
            "default": null
          },
          { "name": "interval_ym_col", "type": [ "null", "string" ], "default": null },
          { "name": "interval_ds_col", "type": [ "null", "string" ], "default": null },
          { "name": "raw_col", "type": [ "null", "bytes" ], "default": null },
          { "name": "blob_col", "type": [ "null", "bytes" ], "default": null },
          { "name": "clob_col", "type": [ "null", "string" ], "default": null },
